{
  "name": "Suite - AI post to x",
  "nodes": [
    {
      "id": "1b7d47a2-b6a5-4315-af69-d736acafecf3",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "fd612f5b-0cf6-4402-81e6-a01087e04f57",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      },
      "disabled": true
    },
    {
      "id": "d90b9ea5-d88e-491f-a49b-532573664534",
      "name": "Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1bf512a8-b689-4cee-955a-75067cedf8b6",
              "name": "suite_url",
              "value": "https://suite.YOUR-SUBDOMAIN.workers.dev",
              "type": "string"
            },
            {
              "id": "2c9f1234-38c1-41eb-b792-56625d3199f0",
              "name": "account_id",
              "value": "PASTE_SOCIAL_ACCOUNT_ID",
              "type": "string"
            },
            {
              "id": "162e23e0-d058-4de2-ae21-fe92674c549b",
              "name": "provider_id",
              "value": "",
              "type": "string"
            },
            {
              "id": "5dac277b-ba01-4493-8e54-4c0878f4d205",
              "name": "model",
              "value": "",
              "type": "string"
            },
            {
              "id": "f166d119-b235-4607-920d-08623b1261b2",
              "name": "topic",
              "value": "Tips for growing a small business online",
              "type": "string"
            },
            {
              "id": "d24e90be-96a0-4a58-96a0-c4aeab715d6e",
              "name": "tone",
              "value": "friendly and concise",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "334c4852-0820-41a8-9db1-f0fa5062d3ba",
      "name": "Generate content (LLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.suite_url }}/api/n8n/generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: \"Write a \" + $json.tone + \" \" + \"x\" + \" post about: \" + $json.topic + \". Output only the post text.\", provider_id: $json.provider_id, model: $json.model, system: \"You are a social media copywriter.\" }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Suite Add-on Token"
        }
      }
    },
    {
      "id": "78d1c9dd-a971-4a49-bfa3-657b1d90bd36",
      "name": "Format for x",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        100
      ],
      "parameters": {
        "jsCode": "const LIMIT = 280;\nlet text = String($input.first().json.text || '').trim().replace(/\\n{3,}/g, '\\n\\n');\nif (text.length > LIMIT) text = text.slice(0, LIMIT - 1).trimEnd() + '\\u2026';\nconst title = text.split('\\n')[0].slice(0, 100);\nreturn [{ json: { text, title, provider: $input.first().json.provider, model: $input.first().json.model } }];"
      }
    },
    {
      "id": "387b5cb8-6747-4854-86c1-f3e8c507f86f",
      "name": "Queue publish job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Parameters').item.json.suite_url }}/api/n8n/jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ task: \"social_publish\", workflow: \"n8n:x\", payload: Object.assign({ account_id: $('Parameters').item.json.account_id, text: $json.text, raw: true }, {}) }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Suite Add-on Token"
        }
      }
    },
    {
      "id": "c141afbc-6763-4278-a515-8f48d7065c26",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1200,
        100
      ],
      "parameters": {
        "amount": 15,
        "unit": "seconds"
      }
    },
    {
      "id": "3810f411-670f-4d0c-acda-8671964c2164",
      "name": "Get job status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Parameters').item.json.suite_url }}/api/n8n/jobs/{{ $('Queue publish job').item.json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Suite Add-on Token"
        }
      }
    },
    {
      "id": "22483539-7274-4e1a-809f-58025c8af349",
      "name": "Finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1680,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "690aeee6-ece6-46b5-8a40-b6e14cbecd79",
              "leftValue": "={{ ['completed','failed','cancelled'].includes($json.status) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
