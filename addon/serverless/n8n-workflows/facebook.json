{
  "name": "Suite - AI post to facebook",
  "nodes": [
    {
      "id": "54bf185e-2a76-4761-a441-3e9af12d9604",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "74308dc7-fdc1-4954-a8bb-12b3fcfa6f49",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      },
      "disabled": true
    },
    {
      "id": "fb92515d-5a3d-4c86-9ef3-d2d04a5aa340",
      "name": "Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f9cc69dc-65cf-42bf-85b5-720f99c6f9b2",
              "name": "suite_url",
              "value": "https://suite.YOUR-SUBDOMAIN.workers.dev",
              "type": "string"
            },
            {
              "id": "c7b2a9c2-ffe7-4d80-a0bd-566dcee3ceaf",
              "name": "account_id",
              "value": "PASTE_SOCIAL_ACCOUNT_ID",
              "type": "string"
            },
            {
              "id": "cbbf17af-5637-4b9e-9232-caba6e7236ec",
              "name": "provider_id",
              "value": "",
              "type": "string"
            },
            {
              "id": "228293e0-0b1b-4b1b-8fc8-2d949b279f19",
              "name": "model",
              "value": "",
              "type": "string"
            },
            {
              "id": "5095c8cf-b70e-4b17-9243-1c089751e614",
              "name": "topic",
              "value": "Tips for growing a small business online",
              "type": "string"
            },
            {
              "id": "335b41e7-0c5a-4842-8daf-29fcf94c0fc8",
              "name": "tone",
              "value": "friendly and concise",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "7749bce3-4585-4847-b30b-cfbd7b963f11",
      "name": "Generate content (LLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.suite_url }}/api/n8n/generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: \"Write a \" + $json.tone + \" \" + \"facebook\" + \" post about: \" + $json.topic + \". Output only the post text.\", provider_id: $json.provider_id, model: $json.model, system: \"You are a social media copywriter.\" }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Suite Add-on Token"
        }
      }
    },
    {
      "id": "4234549d-1d87-4bd8-a626-55a11b88827e",
      "name": "Format for facebook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        100
      ],
      "parameters": {
        "jsCode": "const LIMIT = 63000;\nlet text = String($input.first().json.text || '').trim().replace(/\\n{3,}/g, '\\n\\n');\nif (text.length > LIMIT) text = text.slice(0, LIMIT - 1).trimEnd() + '\\u2026';\nconst title = text.split('\\n')[0].slice(0, 100);\nreturn [{ json: { text, title, provider: $input.first().json.provider, model: $input.first().json.model } }];"
      }
    },
    {
      "id": "a504afa9-fc31-4355-a848-f957bd0d11aa",
      "name": "Queue publish job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Parameters').item.json.suite_url }}/api/n8n/jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ task: \"social_publish\", workflow: \"n8n:facebook\", payload: Object.assign({ account_id: $('Parameters').item.json.account_id, text: $json.text, raw: true }, {}) }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Suite Add-on Token"
        }
      }
    },
    {
      "id": "51d37abd-2eb0-48da-8db3-83c7e646f181",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1200,
        100
      ],
      "parameters": {
        "amount": 15,
        "unit": "seconds"
      }
    },
    {
      "id": "24160a58-19fc-4741-956c-817972729d27",
      "name": "Get job status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Parameters').item.json.suite_url }}/api/n8n/jobs/{{ $('Queue publish job').item.json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Suite Add-on Token"
        }
      }
    },
    {
      "id": "fc0edf23-0763-4a74-af08-ff53dfe85162",
      "name": "Finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1680,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1eb8502-84b9-46b9-8618-850615f8483b",
              "leftValue": "={{ ['completed','failed','cancelled'].includes($json.status) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "19d8b0de-22b8-419e-bd84-abedf2ff7d0c",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1920,
        0
      ],
      "parameters": {}
    }
  ],
