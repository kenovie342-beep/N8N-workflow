{
  "name": "Suite - AI post to instagram",
  "nodes": [
    {
      "id": "fd801214-6dae-4e91-abfe-2a56dedf5849",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "ef40b1de-ece5-4fcd-8f0c-64a684269e6d",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      },
      "disabled": true
    },
    {
      "id": "c9ac364b-3e44-4dde-9bea-5bba266309a9",
      "name": "Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b9621b49-073d-47c4-bda2-9709a10c3692",
              "name": "suite_url",
              "value": "https://suite.YOUR-SUBDOMAIN.workers.dev",
              "type": "string"
            },
            {
              "id": "b11f34c8-cf2f-483c-873e-ee3c6796d544",
              "name": "account_id",
              "value": "PASTE_SOCIAL_ACCOUNT_ID",
              "type": "string"
            },
            {
              "id": "201b0f4c-9964-489b-9841-155a42eaaeb5",
              "name": "provider_id",
              "value": "",
              "type": "string"
            },
            {
              "id": "3caa9e86-9d61-4195-a574-81a5a9251e81",
              "name": "model",
              "value": "",
              "type": "string"
            },
            {
              "id": "ff954e67-ec6c-4c72-a76c-0c28b8fce97c",
              "name": "topic",
              "value": "Tips for growing a small business online",
              "type": "string"
            },
            {
              "id": "fe27e6be-66e3-4c74-bdd6-19671a30e25f",
              "name": "tone",
              "value": "friendly and concise",
              "type": "string"
            },
            {
              "id": "6d32579a-0e33-49e9-b025-511bd07452be",
              "name": "media_url",
              "value": "https://example.com/image.jpg",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "eef66c03-af2a-4981-9a78-3069f8c14663",
      "name": "Generate content (LLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.suite_url }}/api/n8n/generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: \"Write a \" + $json.tone + \" \" + \"instagram\" + \" post about: \" + $json.topic + \". Output only the post text.\", provider_id: $json.provider_id, model: $json.model, system: \"You are a social media copywriter.\" }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Suite Add-on Token"
        }
      }
    },
    {
      "id": "ea3e7404-48c0-4a43-985f-d58831308d82",
      "name": "Format for instagram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        100
      ],
      "parameters": {
        "jsCode": "const LIMIT = 2200;\nlet text = String($input.first().json.text || '').trim().replace(/\\n{3,}/g, '\\n\\n');\nif (text.length > LIMIT) text = text.slice(0, LIMIT - 1).trimEnd() + '\\u2026';\nconst title = text.split('\\n')[0].slice(0, 100);\nreturn [{ json: { text, title, provider: $input.first().json.provider, model: $input.first().json.model } }];"
      }
    },
    {
      "id": "849c261b-1819-4847-9045-7304387db186",
      "name": "Queue publish job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Parameters').item.json.suite_url }}/api/n8n/jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ task: \"social_publish\", workflow: \"n8n:instagram\", payload: Object.assign({ account_id: $('Parameters').item.json.account_id, text: $json.text, raw: true }, { media_url: $('Parameters').item.json.media_url }) }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Suite Add-on Token"
        }
      }
    },
    {
      "id": "006b95b0-4302-4fd9-b0e1-d0e7bf5026bb",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1200,
        100
      ],
      "parameters": {
        "amount": 15,
        "unit": "seconds"
      }
    },
    {
      "id": "417f52b5-6621-4293-b5a7-00dfe878005f",
      "name": "Get job status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Parameters').item.json.suite_url }}/api/n8n/jobs/{{ $('Queue publish job').item.json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Suite Add-on Token"
        }
      }
    },
    {
      "id": "2cb90f44-cb8d-43af-9aae-e5011f0fdf03",
      "name": "Finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1680,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "985362eb-6a73-43c3-831f-72d2f9347989",
              "leftValue": "={{ ['completed','failed','cancelled'].includes($json.status) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "0f722c84-f1f5-4605-9e6b-70200727376c",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1920,
        0
      ],
      "parameters": {}
    }
  ],
