{
  "name": "Suite - AI post to youtube",
  "nodes": [
    {
      "id": "db4174f1-96a9-4443-9cf1-74324982d7c5",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "daa75b36-20c0-4b4e-980c-098ad2467d65",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      },
      "disabled": true
    },
    {
      "id": "9010ee61-648c-42ba-af89-7dd3136bc4e4",
      "name": "Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b8c8f284-55ef-4022-932a-1f11527a5efb",
              "name": "suite_url",
              "value": "http://suite:8080",
              "type": "string"
            },
            {
              "id": "63c1f022-dc68-4b56-8114-3752c64f2ecf",
              "name": "account_id",
              "value": "PASTE_SOCIAL_ACCOUNT_ID",
              "type": "string"
            },
            {
              "id": "738a671f-ffea-4190-8b57-42758ad5add2",
              "name": "provider_id",
              "value": "",
              "type": "string"
            },
            {
              "id": "7c9b80e9-cd7b-47d5-9870-dc2df2bcc7a8",
              "name": "model",
              "value": "",
              "type": "string"
            },
            {
              "id": "26f625ac-0f90-47a2-89ad-99d8d61b9969",
              "name": "topic",
              "value": "Tips for growing a small business online",
              "type": "string"
            },
            {
              "id": "fa301b61-69ba-48ea-8171-c6cc9cdd1697",
              "name": "tone",
              "value": "friendly and concise",
              "type": "string"
            },
            {
              "id": "cb56527d-36de-4fcf-9e73-34fb735f7ee7",
              "name": "media_url",
              "value": "https://example.com/video.mp4",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "6f9c1ae8-a820-4d88-9e1d-630af62ba396",
      "name": "Generate content (LLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.suite_url }}/api/n8n/generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: \"Write a \" + $json.tone + \" \" + \"youtube\" + \" post about: \" + $json.topic + \". Output only the post text.\", provider_id: $json.provider_id, model: $json.model, system: \"You are a social media copywriter.\" }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Suite Add-on Token"
        }
      }
    },
    {
      "id": "4325f519-67fe-4fbe-ade6-9c521ac10098",
      "name": "Format for youtube",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        100
      ],
      "parameters": {
        "jsCode": "const LIMIT = 5000;\nlet text = String($input.first().json.text || '').trim().replace(/\\n{3,}/g, '\\n\\n');\nif (text.length > LIMIT) text = text.slice(0, LIMIT - 1).trimEnd() + '\\u2026';\nconst title = text.split('\\n')[0].slice(0, 100);\nreturn [{ json: { text, title, provider: $input.first().json.provider, model: $input.first().json.model } }];"
      }
    },
    {
      "id": "78fe66a4-38d1-4f33-b698-b1fa252e3587",
      "name": "Queue publish job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Parameters').item.json.suite_url }}/api/n8n/jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ task: \"social_publish\", workflow: \"n8n:youtube\", payload: Object.assign({ account_id: $('Parameters').item.json.account_id, text: $json.text, raw: true }, { media_url: $('Parameters').item.json.media_url, media_type: 'video', title: $json.title }) }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Suite Add-on Token"
        }
      }
    },
    {
      "id": "78efacb0-fa77-499f-af73-9c844d191053",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1200,
        100
      ],
      "parameters": {
        "amount": 15,
        "unit": "seconds"
      }
    },
    {
      "id": "7fee2c0a-fa0d-4018-9d2c-fc44a47d4ad4",
      "name": "Get job status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Parameters').item.json.suite_url }}/api/n8n/jobs/{{ $('Queue publish job').item.json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Suite Add-on Token"
        }
      }
    },
    {
      "id": "d024fc17-988f-4b86-89cd-da2165e765b8",
      "name": "Finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1680,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "bc235b60-8319-4233-bcb2-3a6e0cadde36",
              "leftValue": "={{ ['completed','failed','cancelled'].includes($json.status) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "8a6b868a-1639-4680-ac58-6ae4d2e200e3",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1920,
        0
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Parameters",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule Trigger": {
      "main": [
