# Copy to .env and fill in. Generate secrets with the commands shown. NEVER commit .env.
POSTGRES_USER=automation
POSTGRES_PASSWORD=generate-with: openssl rand -hex 24
POSTGRES_DB=automation
SUITE_PORT=8080
N8N_DOCKER_NETWORK=n8n_default

APP_ENV=production
# python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=generate-me
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"   (BACK THIS UP: losing it makes saved keys unreadable)
APP_ENCRYPTION_KEY=generate-me
# Shared with the GitHub runner (repo secret CALLBACK_SECRET) and the Cloudflare Worker.
CALLBACK_SECRET=generate-me
# Token n8n sends in the X-Addon-Token header (stored in an n8n "Header Auth" credential).
N8N_ADDON_API_TOKEN=generate-me
ADMIN_USERNAME=admin
# Either a plain password or a PBKDF2 hash: python -c "from app.security import hash_password;print(hash_password('your-password'))"
ADMIN_PASSWORD=change-me
ADMIN_PASSWORD_HASH=
PUBLIC_BASE_URL=https://suite.example.com
MAX_CONCURRENT_JOBS=5
DEFAULT_TIMEZONE=Africa/Lagos
# Optional fallbacks (normally configured in the UI, stored encrypted):
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WORKFLOW_ID=remote-job.yml
GITHUB_REF=main
GITHUB_JOB_TIMEOUT_SECONDS=1800
